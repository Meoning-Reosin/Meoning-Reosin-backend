# 이 파일을 복사해 .env 파일을 만들고 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 깃에 올라가지 않습니다(.gitignore). 이 파일(.env.example)에는 진짜 값을 쓰지 마세요.

# --- Google 로그인 (Google Cloud Console > Google Auth Platform > 클라이언트) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google 콘솔의 "승인된 리디렉션 URI"와 글자 하나까지 똑같아야 합니다.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback

# --- JWT ---
# 아무도 추측할 수 없는 긴 무작위 문자열. 만드는 방법:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 비워 두면 서버를 켤 때마다 임시 키를 만들어서, 서버를 다시 켜면 로그인이 풀립니다.
JWT_SECRET=

# --- 프론트 ---
# 로그인이 끝나면 돌아갈 프론트 주소. 비워 두면 콜백이 결과를 JSON으로 보여줍니다(프론트 없이 확인할 때).
FRONTEND_URL=
# 처음 로그인한 사람이 갈 약관 동의 화면 주소. 비워 두면 FRONTEND_URL을 씁니다.
FRONTEND_SIGNUP_URL=
# 이 서버를 부를 프론트 주소(쉼표로 구분). 예: http://127.0.0.1:5500
CORS_ORIGINS=

# --- 배포할 때만 ---
# HTTPS로 배포하면 true로 바꿉니다 (쿠키를 HTTPS에서만 보냄).
COOKIE_SECURE=false

# --- 사진 인식 (선택, 기본값이 있음) ---
# RECOGNITION_CONFIDENCE_THRESHOLD=0.6
# RECOGNITION_MAX_IMAGE_MB=10
